# NEO backend configuration

# HTTP + WebSocket port
PORT=8080

# Allow the Vite dev server (and prod origin) to call the API
CORS_ORIGIN=http://localhost:5173

# Google Gemini (voice assistant). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ESP32 device HTTP endpoint (e.g. http://192.168.1.50). Leave blank to disable.
ESP32_URL=
