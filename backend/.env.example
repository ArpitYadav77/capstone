# NEO backend configuration — all secrets stay server-side.

# MongoDB connection string (Atlas or local, e.g. mongodb://localhost:27017)
MONGODB_URI=

# Google Gemini API key — server-side ONLY (never VITE_ / never sent to the browser)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# HTTP port
PORT=5000

# Allowed browser origin (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
