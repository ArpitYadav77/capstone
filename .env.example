# DeskRobo / NEO frontend environment variables
# The app runs fully client-side in DEMO mode with no backend.
# LIVE mode (real webcam metrics + NEO assistant) uses the local NEO backend.

# NEO backend REST API (ESP32 commands + Gemini assistant)
VITE_NEO_API_URL=http://localhost:8080
# NEO backend dashboard WebSocket (live CV metrics)
VITE_NEO_WS_URL=ws://localhost:8080/dashboard
