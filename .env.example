# DeskRobo / NEO frontend environment variables
# The app runs fully client-side (DEMO mode + in-browser LIVE camera) with no backend.
# The NEO Assistant uses the local NEO backend (Express + MongoDB + Gemini).
#
# NOTE: never put the Gemini key here. Secrets stay server-side in backend/.env.
# There is intentionally no VITE_GEMINI_API_KEY.

# NEO backend REST API (POST /api/chat, /api/sessions)
VITE_NEO_API_URL=http://localhost:5000
